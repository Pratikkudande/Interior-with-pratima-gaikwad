<%- include('../partials/header', { pageTitle: 'Contact' }) %>

<%# ── PAGE HERO ── %>
<section class="page-hero">
  <div class="section-inner">
    <p class="page-hero-eyebrow reveal">Let's talk</p>
    <h1 class="reveal reveal-delay-1">Book a Consultation</h1>
    <p class="page-hero-sub reveal reveal-delay-2">Share a few details about your home or project and we'll get back to you within 24 hours.</p>
  </div>
</section>

<%# ── FORM + SIDEBAR ── %>
<section class="contact-body-section">
  <div class="section-inner">
    <div class="contact-layout">

      <div class="contact-form-wrapper reveal">
        <% if (success) { %>
          <div class="alert success"><%= success %></div>
        <% } %>
        <% if (error) { %>
          <div class="alert error"><%= error %></div>
        <% } %>
        <form action="/contact" method="post" class="contact-form" id="contactForm">
          <input type="hidden" name="service" id="serviceField" value="<%= typeof selectedService !== 'undefined' ? selectedService : '' %>" />

          <div class="field">
            <label for="name">Full name</label>
            <input type="text" id="name" name="name" required placeholder="Your name" />
          </div>

          <div class="field-group">
            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="you@example.com" />
            </div>
            <div class="field">
              <label for="phone">Phone / WhatsApp</label>
              <input type="tel" id="phone" name="phone" required placeholder="+91 ..." />
            </div>
          </div>

          <div class="field">
            <label for="city">City</label>
            <input type="text" id="city" name="city" placeholder="Your city" />
          </div>

          <div class="field">
            <label for="serviceSelect">Service interested in</label>
            <select id="serviceSelect" name="serviceSelect">
              <option value="">Select a service</option>
              <option value="Interior Design" <%= selectedService === 'Interior Design' ? 'selected' : '' %>>Interior Design</option>
              <option value="Home Architecture" <%= selectedService === 'Home Architecture' ? 'selected' : '' %>>Home Architecture</option>
              <option value="Home Plan" <%= selectedService === 'Home Plan' ? 'selected' : '' %>>Home Plan</option>
              <option value="Not sure yet" <%= selectedService === 'Not sure yet' ? 'selected' : '' %>>Not sure yet</option>
            </select>
          </div>

          <div class="field">
            <label for="message">Project details</label>
            <textarea id="message" name="message" rows="4" placeholder="Type, size of space, timeline, budget range..."></textarea>
          </div>

          <button type="submit" class="btn primary full-width">Submit Enquiry</button>
          <p class="form-note">We usually respond within one working day.</p>
        </form>
      </div>

      <aside class="contact-info reveal reveal-delay-2">
        <div class="contact-info-block">
          <h3>Contact details</h3>
          <ul>
            <li>
              <span class="ci-icon">📞</span>
              <div>
                <strong>Phone / WhatsApp</strong>
                <a href="tel:+919552185151">+91 95521 85151</a>
              </div>
            </li>
            <li>
              <span class="ci-icon">📧</span>
              <div>
                <strong>Email</strong>
                <a href="mailto:interiorwithpratima@gmail.com">interiorwithpratima@gmail.com</a>
              </div>
            </li>
            <li>
              <span class="ci-icon">📸</span>
              <div>
                <strong>Instagram</strong>
                <a href="https://www.instagram.com/interior_with_pratima_gaikwad" target="_blank" rel="noreferrer">@interior_with_pratima_gaikwad</a>
              </div>
            </li>
            <li>
              <span class="ci-icon">📍</span>
              <div>
                <strong>Location</strong>
                <span>Pune, Maharashtra 411048</span>
              </div>
            </li>
          </ul>
        </div>
        <div class="contact-info-block">
          <h3>Typical projects</h3>
          <ul class="project-types">
            <li>2/3 BHK apartment interiors</li>
            <li>Villa &amp; bungalow design</li>
            <li>Renovation &amp; re-planning</li>
            <li>Commercial boutique offices</li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</section>

<%- include('../partials/footer') %>
