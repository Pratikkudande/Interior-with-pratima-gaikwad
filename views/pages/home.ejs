<%- include('../partials/header', { pageTitle: 'Timeless Interiors Crafted for You' }) %>

<%# ── HERO ── full-bleed, content constrained inside %>
<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1>Modern Interior Design For Stylish Indian Homes</h1>
      <p>
        We transform ordinary environments into extraordinary experiences through thoughtful design. Whether it's your
        home or workspace, we bring out its full beauty, function, and purpose.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn primary">Book a Consultation</a>
        <a href="/services" class="btn ghost">Explore Services</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="stat-value"><span class="stat-number" data-target="30">0</span><span class="stat-suffix">+</span></div>
          <span class="stat-label" data-short="Projects">Projects</span>
        </div>
        <div class="hero-stat">
          <div class="stat-value"><span class="stat-number" data-target="3">0</span><span class="stat-suffix">+</span></div>
          <span class="stat-label" data-short="Exp">Years Experience</span>
        </div>
        <div class="hero-stat">
          <div class="stat-value"><span class="stat-number" data-target="100">0</span><span class="stat-suffix">%</span></div>
          <span class="stat-label" data-short="Satisfied">Client Satisfaction</span>
        </div>
      </div>
    </div>
    <div class="hero-image">
      <div class="hero-tilt" id="heroTilt">
        <div class="ht-inner">
          <img
            src="https://images.unsplash.com/photo-1505691938895-1758d7feb511?auto=format&fit=crop&w=1200&q=80"
            alt="Modern interior design"
            loading="eager"
            class="ht-img"
          />
          <!-- glare layer -->
          <div class="ht-glare"></div>
          <!-- floating badge -->
          <div class="ht-badge">
            <span class="ht-badge-icon">✦</span>
            <span>30+ Projects</span>
          </div>
          <!-- corner accent lines -->
          <div class="ht-corner ht-corner-tl"></div>
          <div class="ht-corner ht-corner-br"></div>
        </div>
      </div>
    </div>
  </div>
</section>

