      <article class="service-item reveal reveal-delay-1">
        <div class="service-number">01</div>
        <div class="service-icon service-icon-sun">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4.2" />
